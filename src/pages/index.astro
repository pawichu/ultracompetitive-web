---
// src/pages/index.astro
// ADS v2.1 — UltraCompetitive Premium Sovereign Storefront
// Design Identity: Todor Dimov Minimal Oversize Typography (Dark Edition - Vibrant Orange Accent)
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>UltraCompetitive | Sovereign Logistics & Supply Chain Architecture</title>
    
    <script src="//code.tidio.co/phnlyg5kum5wnygb7aqtmzluecmufqao.js" async></script>

    <style>
      /* ------------------------------------------------------------------- */
      /* 🎨 DESIGN SYSTEM & ARCHITECTURE PRINCIPLES (Todor Dimov Inspired)    */
      /* ------------------------------------------------------------------- */
      :root {
        --bg-pure: #030712;
        --bg-surface: #090d16;
        --brand-gold: #FF6B00; /* Updated to Vibrant Orange #FF6B00 */
        --brand-orange: #FF6B00; 
        --brand-blue: #2563eb;
        --text-pure: #ffffff;
        --text-muted: #8292a8;
        --text-dim: #475569;
        --border-subtle: #1e293b;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        scroll-behavior: smooth;
        background-color: var(--bg-pure);
      }

      body {
        background-color: var(--bg-pure);
        color: var(--text-pure);
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      /* 🌐 Navigation Header Layout Structure */
      header {
        max-width: 1400px;
        margin: 0 auto;
        padding: 2.5rem 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1.5rem;
      }

      .logo {
        font-size: 1.1rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }
      .logo span { color: var(--brand-gold); }

      nav {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 2.5rem;
      }

      /* 💡 CONTROLLER: คัดแยกและควบคุมการซ่อน Anchor Link บน Mobile */
      .nav-links {
        display: none;
        gap: 2.5rem;
      }

      @media (min-width: 768px) {
        .nav-links {
          display: flex;
        }
      }

      nav a {
        color: var(--text-muted);
        text-decoration: none;
        font-size: 0.85rem;
        font-weight: 500;
        transition: color 0.3s;
      }
      nav a:hover { color: var(--text-pure); }

      /* 🌐 Language Switcher Widget Setup */
      .lang-switcher {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        border-left: none;
        padding-left: 0;
      }

      @media (min-width: 768px) {
        .lang-switcher {
          border-left: 1px solid var(--border-subtle);
          padding-left: 1.5rem;
        }
      }

      .lang-btn {
        color: var(--text-dim);
        text-decoration: none;
        cursor: pointer;
        transition: color 0.2s;
      }
      .lang-btn.active {
        color: var(--brand-gold);
      }
      .lang-btn:hover { color: var(--text-pure); }

      /* 📦 Structural Layout Container */
      .container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 2rem;
      }

      /* 🏛️ Hero Section: Oversize Typography Hierarchy */
      .hero-section {
        padding: 7rem 0 5rem 0;
        max-width: 1050px;
      }

      .hero-section h1 {
        font-size: clamp(2.2rem, 5vw, 4.8rem);
        line-height: 1.12;
        font-weight: 800;
        letter-spacing: -0.03em;
        margin-bottom: 2rem;
        color: var(--text-pure);
      }

      .hero-section h1 span.gold { color: var(--brand-gold); }
      .hero-section h1 span.muted { color: var(--text-dim); }

      .hero-desc {
        font-size: clamp(1.05rem, 1.6vw, 1.3rem);
        color: var(--text-muted);
        max-width: 750px;
        line-height: 1.6;
        margin-bottom: 3rem;
      }

      /* 🎯 Call to Action (Tidio Trigger Integration) */
      .cta-trigger {
        display: inline-flex;
        align-items: center;
        background: transparent;
        color: var(--text-pure);
        border: 1px solid var(--brand-gold);
        padding: 1rem 2.2rem;
        font-size: 0.9rem;
        font-weight: 600;
        border-radius: 50px;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .cta-trigger:hover {
        background: var(--brand-gold);
        color: #000000;
        box-shadow: 0 0 25px rgba(255, 107, 0, 0.4);
        transform: translateY(-2px);
      }

      /* 📊 Section Sub-headers */
      .section-meta {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        color: var(--brand-gold);
        margin-bottom: 1.5rem;
        font-weight: 700;
      }

      /* 🧩 Todor Dimov Style Split Grid Layout */
      .split-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 4rem;
        padding: 6rem 0;
        border-top: 1px solid var(--border-subtle);
      }
      @media (min-width: 968px) {
        .split-grid {
          grid-template-columns: 4fr 6fr;
          gap: 6rem;
        }
      }

      .grid-sticky-left {
        height: auto;
      }
      @media (min-width: 968px) {
        .grid-sticky-left {
          position: sticky;
          top: 4rem;
          height: fit-content;
        }
      }

      .grid-sticky-left h2 {
        font-size: clamp(2rem, 3.5vw, 3.5rem);
        line-height: 1.1;
        font-weight: 700;
        letter-spacing: -0.02em;
      }

      /* 📑 Minimal Data Rows */
      .data-row {
        display: grid;
        grid-template-columns: 1fr;
        padding: 3rem 0;
        border-bottom: 1px solid var(--border-subtle);
        gap: 1.5rem;
      }
      @media (min-width: 640px) {
        .data-row {
          grid-template-columns: auto 1fr auto;
          gap: 3rem;
        }
      }
      .data-row:first-child { padding-top: 0; }

      .row-index {
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--text-dim);
        padding-top: 0.2rem;
      }

      .row-content h3 {
        font-size: 1.5rem;
        font-weight: 600;
        margin-bottom: 1rem;
        color: var(--text-pure);
      }
      .row-content p {
        color: var(--text-muted);
        font-size: 0.95rem;
        line-height: 1.6;
        max-width: 580px;
      }

      /* 🗺️ Blueprint Image Showcase Container (Mobile Optimized Scroll) */
      .blueprint-container {
        padding: 4rem 0 6rem 0;
        border-top: 1px solid var(--border-subtle);
      }

      .scroll-hint-text {
        font-size: 0.75rem;
        color: var(--text-dim);
        margin-bottom: 0.75rem;
        text-align: right;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.4rem;
      }
      @media (min-width: 768px) {
        .scroll-hint-text {
          display: none;
        }
      }

      .blueprint-scroll-wrapper {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        padding-bottom: 0.75rem;
      }
      .blueprint-scroll-wrapper::-webkit-scrollbar {
        height: 4px;
      }
      .blueprint-scroll-wrapper::-webkit-scrollbar-track {
        background: rgba(30, 41, 59, 0.5);
        border-radius: 4px;
      }
      .blueprint-scroll-wrapper::-webkit-scrollbar-thumb {
        background: var(--brand-gold);
        border-radius: 4px;
      }

      .blueprint-wrapper {
        background-color: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: 12px;
        padding: 2rem;
        display: flex;
        justify-content: center;
        align-items: center;
        min-width: 680px;
      }
      @media (min-width: 768px) {
        .blueprint-wrapper {
          min-width: 0;
          width: 100%;
        }
      }

      .blueprint-img {
        width: 100%;
        height: auto;
        object-contain: fit;
        border-radius: 8px;
        opacity: 0.92;
        transition: opacity 0.3s;
      }
      .blueprint-img:hover { opacity: 1; }

      /* 💳 Valuation Minimal Structure */
      .valuation-matrix {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 2rem;
        margin-top: 3rem;
      }
      .valuation-node {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        padding: 3rem 2.5rem;
        border-radius: 8px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }
      .valuation-node.premium {
        border-color: var(--brand-gold);
        box-shadow: 0 0 30px rgba(255, 107, 0, 0.08);
      }
      .node-title {
        font-size: 1.2rem;
        font-weight: 600;
        margin-bottom: 2rem;
      }
      .node-price {
        font-size: 2.8rem;
        font-weight: 800;
        color: var(--brand-gold);
        letter-spacing: -0.02em;
        margin-bottom: 1rem;
      }

      /* 🔄 Data Warehouse Integration Section */
      .data-warehouse-section {
        padding: 4rem 2rem;
        border-top: 1px solid var(--border-subtle);
        border-bottom: 1px solid var(--border-subtle);
        background: rgba(9, 13, 22, 0.6);
        margin: 5rem 0;
        border-radius: 12px;
      }
      .dw-title {
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        font-weight: 700;
        color: var(--brand-gold);
        text-align: center;
        margin-bottom: 2.5rem;
      }
      .dw-grid {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 1.5rem 2.5rem;
      }
      .dw-card {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem 1.25rem;
        border-radius: 8px;
        background: rgba(15, 23, 42, 0.6);
        border: 1px solid var(--border-subtle);
        transition: all 0.2s ease;
      }
      .dw-card:hover {
        border-color: rgba(255, 107, 0, 0.4);
        transform: translateY(-2px);
      }
      .dw-card span {
        font-size: 0.88rem;
        font-weight: 600;
        letter-spacing: 0.02em;
        color: var(--text-pure);
      }

      /* 🎌 Footer Layout */
      footer {
        max-width: 1400px;
        margin: 0 auto;
        padding: 6rem 2rem 3rem 2rem;
        border-top: 1px solid var(--border-subtle);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 2rem;
        font-size: 0.8rem;
        color: var(--text-dim);
      }

      /* 🦾 Language Layers Toggle Logic Mechanics */
      .lang-layer {
        display: none;
      }
      .lang-layer.active-layer {
        display: block !important;
      }
    </style>
  </head>
  <body>

    <header>
      <div class="logo">Ultra<span>Competitive</span></div>
      <nav>
        <div class="nav-links">
          <a href="#aggregation" onclick="event.preventDefault(); scrollToSection('aggregation');">Aggregation</a>
          <a href="#architecture" onclick="event.preventDefault(); scrollToSection('architecture');">Architecture</a>
          <a href="#valuation" onclick="event.preventDefault(); scrollToSection('valuation');">Valuation</a>
        </div>
        
        <div class="lang-switcher">
          <a href="?lang=en" id="btn-en" class="lang-btn" style="text-decoration: none;">EN</a>
          <span style="color: var(--text-dim); cursor: default;">/</span>
          <a href="?lang=th" id="btn-th" class="lang-btn" style="text-decoration: none;">TH</a>
        </div>
      </nav>
    </header>

    <!-- =================================================================== -->
    <!-- 🌐 ENGLISH LANGUAGE LAYER                                           -->
    <!-- =================================================================== -->
    <div id="layer-en" class="lang-layer">
      <main class="container">
        
        <!-- 🎯 Hero Section (Executive Copy - EN) -->
        <section class="hero-section">
          <h1>Sovereign <span class="gold">Data Pipelines</span> & Enterprise <span class="gold">Supply Chain Infrastructure</span></h1>
          <p class="hero-desc">Engineered for large-scale enterprise control, proprietary business logic, and multi-facility synchronization.</p>
          <button class="cta-trigger" onclick="openTidioChat()">Discuss Architecture Blueprint</button>
        </section>

        <!-- 01 / Aggregation Section -->
        <section class="split-grid section-aggregation-en" id="aggregation-en">
          <div class="grid-sticky-left">
            <div class="section-meta">01 / Functional Core</div>
            <h2>Internal Operations Aggregation</h2>
          </div>
          <div>
            <div class="data-row">
              <span class="row-index">01</span>
              <div class="row-content">
                <h3>Multi-Facility Synchronization</h3>
                <p>Consolidating disparate data streams across production hubs into a unified operational layer. Eliminating latency between inventory deployment and actual warehouse capability.</p>
              </div>
            </div>
            <div class="data-row">
              <span class="row-index">02</span>
              <div class="row-content">
                <h3>Proprietary Logic Ownership</h3>
                <p>Bypassing the constraints of rigid SaaS platforms. Your transactional flows, routing algorithms, and resource allocation logic are engineered natively within your secure perimeter.</p>
              </div>
            </div>
          </div>
        </section>

        <!-- 02 / System Blueprints (Horizontal Mobile Scroll) -->
        <section class="blueprint-container section-architecture-en" id="architecture-en">
          <div class="section-meta">02 / System Blueprints</div>
          <h2 style="font-size: 2.2rem; font-weight: 700; margin-bottom: 2rem; letter-spacing: -0.02em;">The Modular Logistics Blueprint</h2>
          
          <p class="scroll-hint-text">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path></svg>
            Scroll horizontally to view details
          </p>

          <div class="blueprint-scroll-wrapper">
            <div class="blueprint-wrapper">
              <img src="/blueprint-3d.jpeg" alt="The Modular Logistics Blueprint" class="blueprint-img" />
            </div>
          </div>
        </section>

        <!-- 03 / Infrastructure Layers -->
        <section class="split-grid">
          <div class="grid-sticky-left">
            <div class="section-meta">03 / Infrastructure Layers</div>
            <h2>Engineered Network Hierarchy</h2>
          </div>
          <div>
            <div class="data-row">
              <span class="row-index">01</span>
              <div class="row-content">
                <h3>Aggregate End-to-End Supply Chain Layer</h3>
                <p>Consolidating all operational modules into a high-throughput computational system to orchestrate movement across supply nodes seamlessly.</p>
              </div>
            </div>
            <div class="data-row">
              <span class="row-index">02</span>
              <div class="row-content">
                <h3>Modular Logistics Routing</h3>
                <p>Decoupled stream orchestration optimizing multi-modal supply chains for predictability, granular load balance, and asset utilization.</p>
              </div>
            </div>
            <div class="data-row">
              <span class="row-index">03</span>
              <div class="row-content">
                <h3>Functional Logistics Isolation</h3>
                <p>Encapsulating single demands—Air, Sea, Road, and Rail Freight—into granular independent services to guarantee continuous execution safety.</p>
              </div>
            </div>
          </div>
        </section>

        <!-- 04 / Valuation Matrix & Data Warehouse Section -->
        <section style="padding: 6rem 0 2rem 0; border-top: 1px solid var(--border-subtle);" class="section-valuation-en" id="valuation-en">
          <div class="section-meta">04 / Engagement Matrix</div>
          <h2 style="font-size: 2.2rem; font-weight: 700; letter-spacing: -0.02em;">Engineered Valuation Tier</h2>
          
          <div class="valuation-matrix">
            <div class="valuation-node">
              <div>
                <div class="node-title">Architectural Design</div>
                <p style="color: var(--text-muted); font-size: 0.9rem;">Comprehensive data blueprinting, pipeline mapping, and infrastructure advisory tailored for single-entity industrial structures.</p>
              </div>
              <div class="node-price" style="margin-top: 3rem;">$65,000+</div>
            </div>
            <div class="valuation-node premium">
              <div>
                <div class="node-title">Sovereignty Framework</div>
                <p style="color: var(--text-muted); font-size: 0.9rem;">Full operational execution. Custom logistics router engineering, data pipeline building, and absolute infrastructure ownership transfer.</p>
              </div>
              <div class="node-price" style="margin-top: 3rem;">$150,000</div>
            </div>
          </div>
        </section>

        <!-- 🔗 Data Warehouse Integration Section (EN) -->
        <section class="data-warehouse-section">
          <p class="dw-title">Seamlessly Works With Your Existing Enterprise Data Infrastructure</p>
          <div class="dw-grid">
            <!-- Snowflake -->
            <div class="dw-card">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="#29B5E8"><path d="M12 0L9.2 4.8l2.8 1.6V10H6.4L4.8 7.2 0 10l4.8 2.8L0 15.6l4.8 2.8 1.6-2.8H12v3.6l-2.8 1.6L12 24l2.8-4.8-2.8-1.6V14h5.6l1.6 2.8 4.8-2.8-4.8-2.8 4.8-2.8-4.8-2.8-1.6 2.8H12V6.4l2.8-1.6L12 0z"/></svg>
              <span>Snowflake</span>
            </div>
            <!-- Google BigQuery -->
            <div class="dw-card">
              <svg width="22" height="22" viewBox="0 0 24 24"><path fill="#4285F4" d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96z"/><path fill="#34A853" d="M12 11v6l4-2z"/></svg>
              <span>Google BigQuery</span>
            </div>
            <!-- Amazon Redshift -->
            <div class="dw-card">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="#FF9900"><path d="M12 2L2 7v10l10 5 10-5V7L12 2zm0 2.8L18.8 8.4 12 12 5.2 8.4 12 4.8zM4 9.8l7 3.9v6.9l-7-3.5V9.8zm16 7.3l-7 3.5v-6.9l7-3.9v7.3z"/></svg>
              <span>Amazon Redshift</span>
            </div>
            <!-- Databricks -->
            <div class="dw-card">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="#FF3621"><path d="M12 2L2 7.2v9.6L12 22l10-5.2V7.2L12 2zm0 2.4l7.2 3.8-7.2 3.8-7.2-3.8L12 4.4zm-7.2 6.2l7.2 3.8 7.2-3.8v2.4L12 16.8 4.8 13v-2.4zm0 4.8l7.2 3.8 7.2-3.8v2.4L12 21.6l-7.2-3.8v-2.4z"/></svg>
              <span>Databricks</span>
            </div>
            <!-- PostgreSQL -->
            <div class="dw-card">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="#336791"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8 0-1.84.63-3.53 1.69-4.88l11.19 11.19C15.53 19.37 13.84 20 12 20zm6.31-3.12L7.12 5.69C8.47 4.63 10.16 4 12 4c4.41 0 8 3.59 8 8 0 1.84-.63 3.53-1.69 4.88z"/></svg>
              <span>PostgreSQL</span>
            </div>
          </div>
        </section>

      </main>
    </div>

    <!-- =================================================================== -->
    <!-- 🇹🇭 THAI LANGUAGE LAYER                                            -->
    <!-- =================================================================== -->
    <div id="layer-th" class="lang-layer">
      <main class="container">
        
        <!-- 🎯 Hero Section (Executive Copy - TH) -->
        <section class="hero-section">
          <h1>สถาปัตยกรรม <span class="gold">ท่อส่งข้อมูล</span> และโครงสร้าง <span class="gold">Supply Chain ระดับองค์กร</span></h1>
          <p class="hero-desc">วิศวกรรมระบบบริหารจัดการโลจิสติกส์ที่เป็นกรรมสิทธิ์ของคุณ เชื่อมโยงทุกคลังสินค้าและสายการผลิตอย่างสมบูรณ์</p>
          <button class="cta-trigger" onclick="openTidioChat()">ร่วมวิเคราะห์สถาปัตยกรรมระบบ</button>
        </section>

        <!-- 01 / Aggregation Section -->
        <section class="split-grid section-aggregation-th" id="aggregation-th">
          <div class="grid-sticky-left">
            <div class="section-meta">01 / แกนกลางการทำงาน</div>
            <h2>การผสานรวมระบบปฏิบัติการภายใน</h2>
          </div>
          <div>
            <div class="data-row">
              <span class="row-index">01</span>
              <div class="row-content">
                <h3>Multi-Facility Synchronization</h3>
                <p>รวบรวมท่อส่งข้อมูลที่กระจัดกระจายจากหลากหลายฐานการผลิตและคลังสินค้าให้เชื่อมต่อกันเป็นพาร์ทเดียว ลดช่องว่างและความล่าช้าระหว่างการจัดสรรสินค้าคงคลังกับขีดความสามารถจริงหน้างาน</p>
              </div>
            </div>
            <div class="data-row">
              <span class="row-index">02</span>
              <div class="row-content">
                <h3>Proprietary Logic Ownership</h3>
                <p>ก้าวข้ามข้อจำกัดของซอฟต์แวร์สำเร็จรูป (SaaS) ทั่วไป อัลกอริทึมการจัดเส้นทาง ตรรกะธุรกรรม และการบริหารทรัพยากรภายในองค์กรของคุณ จะถูกพัฒนาและจัดเก็บอยู่บนพื้นที่ปลอดภัยที่เป็นกรรมสิทธิ์ของคุณเอง</p>
              </div>
