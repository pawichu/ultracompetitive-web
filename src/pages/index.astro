<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Track Record - Commercial Experience & Operations</title>
  <style>
    /* Global Styles */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: #0d0e11;
      color: #e5e5e5;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      padding: 40px 20px;
      display: flex;
      justify-content: center;
    }

    .container {
      max-width: 960px;
      width: 100%;
    }

    /* Subtitle Top */
    .section-subtitle {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      color: #71767b;
      margin-bottom: 12px;
      font-weight: 600;
    }

    /* Issue 2: Main Header Font set to Helvetica */
    .main-header {
      font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
      font-size: 36px;
      font-weight: 500;
      color: #ffffff;
      margin-bottom: 40px;
      letter-spacing: -0.5px;
    }

    /* Card Item */
    .card {
      margin-bottom: 48px;
    }

    /* Issue 1 Fix: Flexbox Header for perfect alignment */
    .card-header-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 16px;
      flex-wrap: wrap;
    }

    .card-title-group {
      display: flex;
      align-items: baseline;
      gap: 16px;
      flex-wrap: wrap;
    }

    .card-year-meta {
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: #5c6268;
      font-weight: 600;
      white-space: nowrap;
    }

    .card-title {
      font-size: 22px;
      font-weight: 500;
      color: #ffffff;
      letter-spacing: -0.3px;
    }

    /* Clean Aligned Tag */
    .tag {
      background-color: #1a1c23;
      border: 1px solid #2a2d37;
      color: #8b929a;
      font-size: 12px;
      padding: 4px 12px;
      border-radius: 4px;
      white-space: nowrap;
    }

    /* Image Container */
    .card-image-wrapper {
      width: 100%;
      height: 420px;
      border-radius: 8px;
      overflow: hidden;
      background-color: #1a1c23;
    }

    .card-image-wrapper img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
  </style>
</head>
<body>

  <div class="container">
    
    <div class="section-subtitle">Track Record</div>
    
    <!-- Issue 2: Uses Helvetica -->
    <h1 class="main-header">Commercial Experience & Operations</h1>

    <!-- Card 1 -->
    <div class="card">
      <!-- Issue 1: Align meta, title, and tag cleanly in one row -->
      <div class="card-header-row">
        <div class="card-title-group">
          <span class="card-year-meta">2021 CONTAINER MOBILIZATION</span>
          <h2 class="card-title">Supply Chain & Port Infrastructure</h2>
        </div>
        <span class="tag">Consultation</span>
      </div>
      
      <div class="card-image-wrapper">
        <img src="https://images.unsplash.com/photo-1578575437130-527eed3abbec?auto=format&fit=crop&w=1200&q=80" alt="Supply Chain & Port Infrastructure">
      </div>
    </div>

    <!-- Card 2 -->
    <div class="card">
      <div class="card-header-row">
        <div class="card-title-group">
          <span class="card-year-meta">2020 FULFILLMENT HUB</span>
          <h2 class="card-title">Cross-Border E-Commerce Logistics</h2>
        </div>
        <span class="tag">Shenzhen, CN</span>
      </div>
      
      <div class="card-image-wrapper">
        <img src="https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?auto=format&fit=crop&w=1200&q=80" alt="Cross-Border E-Commerce Logistics">
      </div>
    </div>

    <!-- Card 3 (Example for Bangkok, TH) -->
    <div class="card">
      <div class="card-header-row">
        <div class="card-title-group">
          <span class="card-year-meta">2019 LOGISTICS NETWORK</span>
          <h2 class="card-title">Regional Distribution Expansion</h2>
        </div>
        <span class="tag">Bangkok, TH</span>
      </div>
      
      <div class="card-image-wrapper">
        <img src="https://images.unsplash.com/photo-1580674684081-7617fbf3d745?auto=format&fit=crop&w=1200&q=80" alt="Regional Distribution Expansion">
      </div>
    </div>

    <!-- Card 4 (Example for Melbourne - Cologne) -->
    <div class="card">
      <div class="card-header-row">
        <div class="card-title-group">
          <span class="card-year-meta">2018 GLOBAL ROUTING</span>
          <h2 class="card-title">Intercontinental Freight Corridor</h2>
        </div>
        <span class="tag">Melbourne - Cologne</span>
      </div>
      
      <div class="card-image-wrapper">
        <img src="https://images.unsplash.com/photo-1519003722824-194d4455a60c?auto=format&fit=crop&w=1200&q=80" alt="Intercontinental Freight Corridor">
      </div>
    </div>

  </div>

</body>
</html>