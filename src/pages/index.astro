    <script is:inline>
      function orchestrateLanguage() {
        const urlParams = new URLSearchParams(window.location.search);
        let lang = urlParams.get('lang');

        if (!lang) {
          const userLang = navigator.language || navigator.userLanguage;
          lang = userLang.startsWith('th') ? 'th' : 'en';
        }

        const layerEn = document.getElementById('layer-en');
        const layerTh = document.getElementById('layer-th');
        const btnEn = document.getElementById('btn-en');
        const btnTh = document.getElementById('btn-th');

        if (lang === 'th') {
          if (layerTh) layerTh.classList.add('active-layer');
          if (layerEn) layerEn.classList.remove('active-layer');
          if (btnTh) btnTh.classList.add('active');
          if (btnEn) btnEn.classList.remove('active');
          document.documentElement.lang = 'th';
        } else {
          if (layerEn) layerEn.classList.add('active-layer');
          if (layerTh) layerTh.classList.remove('active-layer');
          if (btnEn) btnEn.classList.add('active');
          if (btnTh) btnTh.classList.remove('active');
          document.documentElement.lang = 'en';
        }
      }

      function scrollToSection(sectionName) {
        const urlParams = new URLSearchParams(window.location.search);
        const lang = urlParams.get('lang') || (navigator.language.startsWith('th') ? 'th' : 'en');
        
        const targetId = `${sectionName}-${lang}`;
        const targetElement = document.getElementById(targetId);
        
        if (targetElement) {
          targetElement.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }

      orchestrateLanguage();
      window.addEventListener('DOMContentLoaded', orchestrateLanguage);

      // ===================================================================
      // 🔥 Tidio Chat Trigger Handler
      // ===================================================================
      function openTidioChat() {
        if (typeof tidioChatApi !== 'undefined') {
          tidioChatApi.open();
        } else {
          window.tidioChatApi = window.tidioChatApi || {};
          window.tidioChatApi.onload = function() {
            window.tidioChatApi.open();
          };
        }
      }
    </script>
