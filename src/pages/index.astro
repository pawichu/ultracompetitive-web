    <script>
      function initLanguage() {
        const btnTh = document.getElementById('btn-th');
        const btnEn = document.getElementById('btn-en');
        const html = document.documentElement;

        let currentLang = localStorage.getItem('ultra-lang') || 'en';
        updateUI(currentLang);

        function updateUI(lang) {
          html.setAttribute('data-lang', lang);
          localStorage.setItem('ultra-lang', lang);
          
          if (lang === 'th') {
            btnTh.className = "text-amber-500 font-bold focus:outline-none cursor-pointer transition-colors duration-200";
            btnEn.className = "text-slate-500 hover:text-white font-bold focus:outline-none cursor-pointer transition-colors duration-200";
          } else {
            btnEn.className = "text-amber-500 font-bold focus:outline-none cursor-pointer transition-colors duration-200";
            btnTh.className = "text-slate-500 hover:text-white font-bold focus:outline-none cursor-pointer transition-colors duration-200";
          }
        }

        if(btnTh && btnEn) {
          btnTh.addEventListener('click', () => updateUI('th'));
          btnEn.addEventListener('click', () => updateUI('en'));
        }
      }

      initLanguage();
      document.addEventListener('astro:after-swap', () => {
        initLanguage();
      });
    </script>
